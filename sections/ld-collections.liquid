<section class="ld-collections ld-section">
  <div class="ld-container">
    <div class="ld-section-heading text-center">
      <p class="ld-label">Explore</p>
      <h2>Timeless pieces. For every moment.</h2>
    </div>

    <div class="ld-collections-editorial">

      <a href="/collections/engagement" class="ld-collection-feature ld-collection-feature--large">
        <div
          class="ld-collection-feature__image"
          style="background-image: url('{{ "collection-1.png" | asset_url }}');">
        </div>

        <div class="ld-collection-feature__content">
          <p class="ld-label">The Bridal Collection</p>
          <h3>Forever <em>begins here.</em></h3>
          <div class="ld-divider"></div>
          <p>Celebrate love with rings as unforgettable as your story.</p>
          <span class="ld-button">Discover Engagement</span>
        </div>
      </a>

      <div class="ld-category-strip">

  <a href="/collections/engagement-rings" class="ld-category-card">
    <div
      class="ld-category-card__image"
      style="background-image:url('{{ "category-1.png" | asset_url }}');">
    </div>

    <div class="ld-category-card__content">
      <span class="ld-category-card__title">
        Engagement Rings
      </span>
    </div>
  </a>

  <a href="/collections/necklaces" class="ld-category-card">
    <div
      class="ld-category-card__image"
      style="background-image:url('{{ "category-2.png" | asset_url }}');">
    </div>

    <div class="ld-category-card__content">
      <span class="ld-category-card__title">
        Necklaces
      </span>
    </div>
  </a>

  <a href="/collections/earrings" class="ld-category-card">
    <div
      class="ld-category-card__image"
      style="background-image:url('{{ "category-3.png" | asset_url }}');">
    </div>

    <div class="ld-category-card__content">
      <span class="ld-category-card__title">
        Earrings
      </span>
    </div>
  </a>

  <a href="/collections/rings" class="ld-category-card">
    <div
      class="ld-category-card__image"
      style="background-image:url('{{ "category-4.png" | asset_url }}');">
    </div>

    <div class="ld-category-card__content">
      <span class="ld-category-card__title">
        Rings
      </span>
    </div>
  </a>

  <a href="/collections/bracelets" class="ld-category-card">
    <div
      class="ld-category-card__image"
      style="background-image:url('{{ "category-5.png" | asset_url }}');">
    </div>

    <div class="ld-category-card__content">
      <span class="ld-category-card__title">
        Bracelets
      </span>
    </div>
  </a>

</div>

      <div class="ld-collection-split">
        <a href="/collections/everyday" class="ld-collection-feature">
          <div
            class="ld-collection-feature__image"
            style="background-image: url('{{ "collection-2.png" | asset_url }}');">
          </div>
        </a>

        <a href="/collections/everyday" class="ld-collection-copy">
          <p class="ld-label">Everyday Luxury</p>
          <h3>Live your <em>best life.</em></h3>
          <div class="ld-divider"></div>
          <p>Effortless pieces that elevate the moments that matter most.</p>
          <span class="ld-button">Shop the Edit</span>
        </a>
      </div>

      <a href="/collections/summer" class="ld-collection-feature ld-collection-feature--wide">
        <div
          class="ld-collection-feature__image"
          style="background-image: url('{{ "collection-3.png" | asset_url }}');">
        </div>

        <div class="ld-collection-feature__content ld-collection-feature__content--light">
          <p class="ld-label">The Vacation Edit</p>
          <h3>The Vacation <em>Collection</em></h3>
          <div class="ld-divider"></div>
          <p>Light, effortless, and made to shine wherever you go.</p>
          <span class="ld-button">Explore the Collection</span>
        </div>
      </a>

      <div class="ld-collection-duo">
        <a href="/collections/gifts" class="ld-collection-tile">
          <div
            class="ld-collection-tile__image"
            style="background-image: url('{{ "collection-4.png" | asset_url }}');">
          </div>

          <div class="ld-collection-tile__content">
            <p class="ld-label">Gift Beautifully</p>
            <h3>Make it meaningful.</h3>
            <p>Thoughtful pieces for life's most cherished moments.</p>
            <span class="ld-link">Shop Gifts</span>
          </div>
        </a>

        <a href="/collections/necklaces" class="ld-collection-tile">
          <div
            class="ld-collection-tile__image"
            style="background-image: url('{{ "collection-5.png" | asset_url }}');">
          </div>

          <div class="ld-collection-tile__content">
            <p class="ld-label">Fine Details</p>
            <h3>The perfect finishing touch.</h3>
            <p>Delicate designs that bring every look together.</p>
            <span class="ld-link">Shop Necklaces</span>
          </div>
        </a>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "LD Collections",
  "settings": [],
  "presets": [
    {
      "name": "LD Collections"
    }
  ]
}
{% endschema %}